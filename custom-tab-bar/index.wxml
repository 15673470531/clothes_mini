<view class="tab-bar">
  <view
    wx:for="{{list}}"
    wx:key="text"
    class="tab-item {{selected === index ? 'on' : ''}}"
    bindtap="onTab"
    data-index="{{index}}"
    data-path="{{item.pagePath}}">
    <view class="tab-icon icon-{{item.icon}}"></view>
    <text class="tab-text">{{item.text}}</text>
  </view>
</view>
