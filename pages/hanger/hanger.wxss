/* 衣架说明页（2026-09 · 方案 1）
   卡片/文字色只用 app.wxss 的变量，不引新色；分块样式跟「关于应用」页一套（hero + sec + feat），
   保持整站一个观感。 */

/* ---- 当前剩余 ---- */

.hero {
  padding: 40rpx 32rpx 36rpx;
  text-align: center;
  background: var(--brand-light);   /* 唯一带底色的卡：一眼知道这是"头" */
  box-shadow: none;                 /* 有底色不叠阴影，免得发脏 */
}

.hero-icon {
  display: flex;
  justify-content: center;
  margin-bottom: 20rpx;
}

.ico {
  width: 64rpx;
  height: 64rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 64rpx 64rpx;
}

.ico-hanger {
  background-image: url("data:image/svg+xml;base64,");
}

/* 顶部大数字（只有总数，2026-09 用户定：每日数量不显示） */
.hero-nums {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.hn-val {
  font-size: 48rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: var(--text);
}

/* 状态色：剩得少=黄、用完=红（阈值在 utils/hanger.js，跟「我的」页那一行同源） */
.hn-low { color: #C08A2E; }
.hn-none { color: var(--danger); }

.hn-label {
  font-size: var(--fs-tiny);
  color: var(--text-sub);
}

/* 用完那句提示：给出路，别只报数字 */
.hero-full {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(93, 76, 124, 0.14);
  font-size: var(--fs-tiny);
  color: var(--text-sub);
  line-height: 1.7;
  text-align: left;
}

/* ---- 分块（跟 about 页同一套层级）---- */

.sec {
  margin-top: 28rpx;
  padding: 32rpx;
}

.sec-title {
  position: relative;
  padding-left: 20rpx;
  font-size: var(--fs-strong);
  font-weight: 600;
  letter-spacing: 0.5rpx;
  line-height: 1.4;
}

.sec-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 32rpx;
  border-radius: var(--r-pill);
  background: var(--brand);
}

.feat {
  margin-top: 26rpx;
}

.feat + .feat {
  padding-top: 26rpx;
  border-top: 1rpx solid var(--line);
}

.feat-name {
  display: block;
  font-size: var(--fs-sub);
  font-weight: 600;
}

.feat-desc {
  display: block;
  margin-top: 8rpx;
  font-size: var(--fs-tiny);
  color: var(--text-sub);
  line-height: 1.7;
}
