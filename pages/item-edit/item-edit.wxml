<view class="page page-with-bar">

  <!-- 状态那两行删掉了（2026-09 口径：提交成功才算保存，不存在「待入库」这种中间态） -->

  <!-- 批量录入进度：一次从相册选了多张时才出现 -->
  <view wx:if="{{queueText}}" class="q-head">
    <text class="q-progress">{{queueText}}</text>
  </view>

  <!-- 卡一：照片 + 品类（都是必填，放一起） -->
  <view class="card pad">

    <!-- 一次选多张：并排缩略图，点哪张填哪张（已录的置灰打勾，点它会提示） -->
    <scroll-view wx:if="{{photos.length > 1}}" class="ph-strip" scroll-x>
      <view
        wx:for="{{photos}}"
        wx:key="path"
        class="ph-thumb {{index === cur ? 'ph-on' : ''}} {{item.done ? 'ph-done' : ''}}"
        bindtap="onPickThumb"
        data-i="{{index}}">
        <image class="ph-thumb-img" src="{{item.path}}" mode="aspectFill"></image>
        <view wx:if="{{item.done}}" class="ph-tick">✓</view>
      </view>
    </scroll-view>

    <!-- 已有照片：左缩略图 + 右侧说明与操作 -->
    <!-- photoSrc = 本地路径 || 远程地址：本地文件被系统清掉后还能显示云端那张，不至于以为照片丢了 -->
    <view wx:if="{{photoSrc}}" class="photo-row">
      <view class="photo-wrap">
        <image class="photo-img" src="{{photoShow}}" mode="aspectFill"></image>
      </view>
      <view class="photo-side">
        <!-- 二期图片上云后改口径：照片保存时会上传到云端（本机那份只是在，显示更快） -->
        <view class="photo-hint">照片会自动同步到云端</view>
        <view class="photo-btns">
          <view class="mini-btn mini-btn-brand" bindtap="onPickSource">换一张</view>
          <view class="mini-btn" bindtap="onRemoveImage">删除</view>
        </view>
      </view>
    </view>

    <!-- 还没有照片：两个来源按钮 -->
    <view wx:else class="photo-src">
      <view class="photo-src-btn" bindtap="onPickCamera">拍照</view>
      <view class="photo-src-btn" bindtap="onPickAlbum">从相册选择</view>
    </view>

    <view class="divider"></view>

    <view class="label">品类 · 必选</view>
    <view class="grid">
      <view
        wx:for="{{cats}}"
        wx:key="key"
        class="cell col3 {{item.on ? 'on' : ''}}"
        bindtap="onPickCat"
        data-key="{{item.key}}">{{item.name}}</view>
    </view>

    <!-- 二级类目：选完一级品类才出现，可不选（再点一次取消） -->
    <block wx:if="{{subs.length}}">
      <view class="label label-gap">细分 · 可不选</view>
      <view class="row5">
        <view
          wx:for="{{subs}}"
          wx:key="key"
          class="cell cell-sm {{item.on ? 'on' : ''}}"
          bindtap="onPickSub"
          data-key="{{item.key}}">{{item.name}}</view>
      </view>
    </block>
  </view>

  <!-- 卡二：季节 + 名称 -->
  <view class="card pad">
    <view class="label">季节</view>
    <view class="row5">
      <view
        wx:for="{{seasons}}"
        wx:key="value"
        class="cell {{item.on ? 'on' : ''}}"
        bindtap="onToggleSeason"
        data-value="{{item.value}}">{{item.value}}</view>
    </view>

    <view class="divider"></view>

    <view class="name-row">
      <text class="name-label">名称</text>
      <input
        class="form-input"
        placeholder="可不填"
        placeholder-class="form-ph"
        value="{{name}}"
        bindinput="onInputName" />
    </view>
  </view>

  <!-- 卡三：更多属性（颜色 / 场合），默认折叠 -->
  <view class="card pad">
    <view class="more-head" bindtap="onToggleMore">
      <view class="more-left">
        <view class="more-title">更多属性</view>
        <view class="more-sub">颜色 / 场合</view>
      </view>
      <text class="sec-opt">{{moreSummary}}</text>
      <view class="chevron {{moreOpen ? 'chevron-open' : ''}}"></view>
    </view>

    <block wx:if="{{moreOpen}}">
      <view class="divider"></view>

      <view class="label">颜色</view>
      <view class="colors">
        <view
          wx:for="{{colors}}"
          wx:key="key"
          class="color"
          bindtap="onToggleColor"
          data-key="{{item.key}}">
          <view class="dot {{item.on ? 'dot-on' : ''}} {{item.hex === '#ffffff' ? 'dot-light' : ''}}" style="background:{{item.hex}}"></view>
          <text class="color-name">{{item.name}}</text>
        </view>
      </view>

      <view class="divider"></view>

      <view class="label">场合</view>
      <view class="row5">
        <view
          wx:for="{{occasions}}"
          wx:key="value"
          class="cell {{item.on ? 'on' : ''}}"
          bindtap="onToggleOccasion"
          data-value="{{item.value}}">{{item.value}}</view>
      </view>
    </block>
  </view>

  <!-- 批量录入：这一批还有别的没录，给一个「剩下几张都用这套属性」的口子 -->
  <view wx:if="{{isAdd && restCount > 0}}" class="card batch-row" bindtap="onToggleBatch">
    <view class="batch-box {{batchSame ? 'batch-box-on' : ''}}">
      <text wx:if="{{batchSame}}" class="batch-tick">✓</text>
    </view>
    <view class="batch-info">
      <view class="batch-title">剩下 {{restCount}} 张都用这套属性</view>
      <view class="batch-sub">品类 / 颜色 / 季节 / 场合照现在这套，一次全存下来</view>
    </view>
  </view>

  <!-- 洗白底（归一化 · 2026-09）：去掉背景杂物生成白底商品图；洗完由用户决定要不要拿它当封面。
       后端开关关着（NORMALIZE_ENABLED=false）或者没照片时，整行不出现。 -->
  <view wx:if="{{normalizeOn && photoSrc}}" class="wash-row" hover-class="pressed" bindtap="onNormalize">
    <image wx:if="{{whiteUrl}}" class="wash-thumb" src="{{whiteUrl}}" mode="aspectFill" lazy-load></image>
    <view class="wash-info">
      <view class="wash-title">{{normEntryTitle}}</view>
      <view class="wash-sub">{{normEntrySub}}</view>
    </view>
    <text class="wash-left">{{normLeftText}}</text>
    <view class="chevron"></view>
  </view>

  <!-- 对比层：左原图 / 右白底图，用户点一下决定封面用哪张（不选也行，点空白处关掉） -->
  <view wx:if="{{compareOpen}}" class="cmp-mask" bindtap="onCompareClose">
    <view class="cmp-box" catchtap="noop">
      <view class="cmp-title">{{compareTitle}}</view>
      <view class="cmp-row">
        <view class="cmp-item">
          <image class="cmp-img" src="{{compareLeft}}" mode="aspectFit"></image>
          <text class="cmp-cap">{{labelOrig}}</text>
        </view>
        <view class="cmp-item">
          <image class="cmp-img" src="{{compareRight}}" mode="aspectFit"></image>
          <text class="cmp-cap cmp-cap-on">{{labelWhite}}</text>
        </view>
      </view>
      <view class="cmp-hint">{{compareHint}}</view>
      <view class="cmp-btns">
        <view class="cmp-btn {{coverChoice === 'orig' ? 'cmp-btn-on' : ''}}" bindtap="onKeepOriginal">{{btnKeep}}</view>
        <view class="cmp-btn cmp-btn-main {{coverChoice === 'white' ? 'cmp-btn-on' : ''}}" bindtap="onUseWhite">{{btnUse}}</view>
      </view>
    </view>
  </view>

  <!-- 删除：只在编辑已有衣物时出现。放底部栏上方单独一行，不做成第三个按钮（避免误点） -->
  <view wx:if="{{isEdit}}" class="del-row" bindtap="onDelete" hover-class="pressed">
    <text class="del-txt">删除这件衣物</text>
  </view>

  <!-- 底部常驻操作栏 -->
  <view class="bar">
    <view class="bar-btns">
      <!-- 一批多张时不显示「再记一件」：保存会自动跳到下一张没录的，多一个按钮反而费解 -->
      <view wx:if="{{isAdd && photos.length < 2}}" class="btn btn-ghost" bindtap="onSaveAndNext">再记一件</view>
      <view class="btn btn-primary" hover-class="pressed" bindtap="onSave">
        {{isAdd && batchSame && restCount > 0 ? '保存这 ' + (restCount + 1) + ' 件' : '保存'}}
      </view>
    </view>
  </view>
</view>
