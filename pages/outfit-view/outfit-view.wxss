/* 搭配预览页：只留本页布局（卡片/胶囊/底栏/位图走 app.wxss） */

/* 名称行（.name-row / .name-label 在 app.wxss，跟记录衣物页共用同一套）
 * 输入框占满剩余宽度，右边留「N 件」 */
.pv-name {
  flex: 1;
  min-width: 0;
}

.pv-count {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: var(--fs-tiny);
  color: var(--text-weak);
}

/* 位图画布：现在排第一张卡（整块居中；.pos-* 全套在 app.wxss，格子用默认 180rpx） */
.pv-canvas {
  margin-top: 0;
}

/* 名称 / 场合卡：跟在九宫格下面 */
.pv-info {
  margin-top: 24rpx;
}

/* 空格提示：只留极淡的 ＋（.pos-add 在 app.wxss；这里没有品类文字了） */
.pv-hint {
  margin-top: 20rpx;
  text-align: center;
  font-size: var(--fs-tiny);
  color: var(--text-weak);
}

/* 出图用的隐藏画布：canvas 是原生组件，挪到屏幕外，别遮挡页面 */
.shot-canvas {
  position: fixed;
  left: -9999rpx;
  top: 0;
  width: 375px;
  height: 375px;
}

.pv-warn {
  margin-top: 24rpx;
  text-align: center;
  font-size: var(--fs-tiny);
  color: var(--warning);
}

/* 新建流程的提醒：这页点「完成」才保存（主题色，比 hint 显眼但不报警） */
.pv-draft {
  margin-top: 10rpx;
  text-align: center;
  font-size: var(--fs-tiny);
  color: var(--brand);
}

/* 编辑工具条：预览独立于底部保存动作。 */
.pv-toolbar { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.pv-toolbar-title { font-size: var(--fs-sub); color: var(--text-sub); font-weight: 500; }
.pv-preview {
  padding: 12rpx 28rpx; border-radius: var(--r-pill);
  background: var(--brand-light); color: var(--brand); font-size: var(--fs-sub); font-weight: 500;
}
.pv-preview-pressed { opacity: 0.7; }
.pos-slot { border-radius: 20rpx; transition: box-shadow 120ms ease, opacity 120ms ease; }
.pv-dragging .pos-del { visibility: hidden; }
.pv-dragging .pos-hot {
  box-shadow: 0 0 0 5rpx var(--brand), 0 0 0 10rpx var(--brand-light);
  background: var(--brand-light);
}
.pv-dragging .pos-hot .pos-img { opacity: 0.65; }
.pos-dropped { box-shadow: 0 0 0 4rpx var(--brand); }
.pos-ghost {
  transform: translate(-50%, -50%) scale(1.06);
  border-radius: 20rpx; background: var(--card);
  box-shadow: 0 16rpx 36rpx rgba(74, 58, 92, 0.22); opacity: 0.96;
}
.pv-dragging .pv-hint { color: var(--brand); }
