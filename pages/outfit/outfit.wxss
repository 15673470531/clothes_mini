/* 穿搭页：只留本页布局（场合筛选行 .cats/.cat、图片墙 .wall 系列都在 app.wxss 共用件里） */

/* 穿搭列表：**2 个一行**（用户 2026-09：3 个一行图太小，看不清）
 * 共用件 .wall 是 3 列给衣橱用的，这里只覆盖本页的，不动衣橱。
 * 封面是 750×750 方图 → 格子里也是正方形，aspectFill 不裁内容（用户的底线）。 */

/* 和顶部那排场合选项之间留点间距（用户 2026-09：贴着太挤） */
.oc-wall {
  margin-top: 0;
}

/* 每套搭配一张白底卡：图 + 名字都包在卡里（跟日历页/我的页的卡片风格统一）
 * 宽度算法（改页面 padding 时要跟着改）：可用宽 702rpx、两列间距 16rpx
 *   → 每张卡 (702-16)/2 = 343rpx；卡内左右留白 12rpx → 图宽 343-24 = 319rpx，高度取同值保持方形 */
.oc-cell {
  width: calc((100% - 16rpx) / 2);
  padding: 12rpx 12rpx 16rpx;
  background: var(--card);
  border-radius: var(--r-card);
  box-shadow: none;
}

.oc-cell .wall-pic {
  height: 319rpx;
  background: #fff;
  border-radius: 12rpx;
}

/* 名字在卡里，跟图留一点距离 */
.oc-cell .wall-text {
  margin-top: 0;
  font-size: var(--fs-sub);
  font-weight: 500;
  color: var(--text);
  text-align: left;
  flex: 1;
  min-width: 0;
}

/* 缩略图外面包一层，用来放角标 */
.oc-pic {
  position: relative;
}

/* 角标：件数 / 缺N */
.oc-badge {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  min-width: 40rpx;
  height: 40rpx;
  padding: 0 12rpx;
  border-radius: var(--r-pill);
  background: rgba(20, 23, 29, 0.62);
  color: #ffffff;
  font-size: 22rpx;
  line-height: 40rpx;
  text-align: center;
}

/* 有衣物被删除：警示色 */
.oc-badge-warn {
  background: var(--fill);
  color: var(--text-sub);
}

/* 右下角小圆点：封面存哪了（只给颜色，不写字，口径同衣橱）
 * 右上角是件数角标，一个右上、一个右下，互不遮挡 */
.oc-store {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.25);
}

.oc-store-wait {
  background: rgba(0, 0, 0, 0.45);
}

.oc-store-local {
  background: var(--warning);
}

/* 空态插画（后端下发的透明底图） */
.empty-pic-ot { width: 320rpx; }

/* 与衣橱一致的紧凑筛选区。 */
.cats { margin-bottom: 12rpx; }
.cat { padding: 14rpx 24rpx; margin-right: 12rpx; color: var(--text-sub); }
.cat.tag-on { color: var(--brand); font-weight: 600; }
.result-count {
  margin: 4rpx 4rpx 16rpx;
  color: var(--text-weak);
  font-size: var(--fs-tiny);
  line-height: 1.5;
}
.oc-info { padding: 8rpx 8rpx 0; }
.oc-title-row { display: flex; align-items: center; gap: 8rpx; }
.oc-more {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-sub);
  font-size: var(--fs-strong);
  border-radius: var(--r-pill);
}
.oc-more-pressed { background: var(--fill); }
.oc-meta {
  color: var(--text-weak);
  font-size: var(--fs-tiny);
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 兜底拼图与正式封面等高，图片切换时卡片不跳动。 */
.oc-collage {
  height: 319rpx;
  padding: 12rpx;
  border-radius: 12rpx;
  background: #fff;
  display: grid;
  gap: 8rpx;
}
.oc-cols-1 { grid-template-columns: 1fr; grid-template-rows: 1fr; }
.oc-cols-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: minmax(0, 1fr); }
.oc-cols-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); grid-auto-rows: minmax(0, 1fr); }
.oc-tile { min-width: 0; min-height: 0; overflow: hidden; border-radius: 12rpx; }
.oc-tile-image { display: block; width: 100%; height: 100%; }
.oc-tile-placeholder {
  width: 100%; height: 100%;
  display: flex; align-items: center; justify-content: center;
  font-size: var(--fs-title);
}
.oc-no-items {
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  gap: 12rpx; color: var(--text-weak); font-size: var(--fs-tiny);
}
.oc-no-items-title { color: var(--text-sub); }

/* 仅用于生成缺封面的临时预览，不写入搭配记录。 */
.preview-canvas { position: fixed; left: -9999rpx; top: 0; width: 375px; height: 375px; }

.login-empty { padding-top: 64rpx; }
.login-title { display: block; margin-bottom: 12rpx; color: var(--text); font-size: var(--fs-strong); font-weight: 600; }

/* 空态：插画、标题、说明和一个主入口。 */
.outfit-empty { padding: 52rpx 24rpx 72rpx; }
.outfit-empty .empty-img, .login-empty .empty-img { margin-bottom: 28rpx; }
.outfit-empty-title { display: block; color: var(--text); font-size: var(--fs-strong); font-weight: 600; line-height: 1.5; }
.outfit-empty-desc { margin-top: 14rpx; line-height: 1.8; font-size: var(--fs-sub); }
.outfit-filter-empty { padding: 96rpx 24rpx; }
