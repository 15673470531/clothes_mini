.intro { padding: 16rpx 4rpx 28rpx; }.title { font-size: var(--fs-strong); font-weight: 600; }.hint { color:var(--text-weak); font-size:var(--fs-tiny); line-height:1.8; margin-top:10rpx; }.section { font-size:var(--fs-sub); font-weight:600; }.card { margin-bottom:20rpx; }.portrait-row { display:flex; gap:16rpx; padding:16rpx 0; }.portrait { flex-shrink:0; width:160rpx; border:3rpx solid transparent; border-radius:16rpx; overflow:hidden; }.portrait image {width:100%;height:210rpx;display:block;}.selected {border-color:var(--brand)!important;background:var(--brand-light);}.small {font-size:var(--fs-tiny);color:var(--brand);padding:16rpx;text-align:center;}.items {display:flex;flex-wrap:wrap;gap:16rpx;margin-top:16rpx;}.garment {width:calc((100% - 32rpx)/3);border:3rpx solid transparent;border-radius:16rpx;padding:6rpx;}.garment image {width:100%;height:160rpx;display:block;background:var(--card);}.name {font-size:var(--fs-tiny);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}.consent {font-size:var(--fs-tiny);line-height:1.8;color:var(--text-sub);}.generate {margin-top:20rpx;background:var(--brand);color:var(--card);border-radius:var(--r-pill);font-size:var(--fs-sub);}.result {width:100%;display:block;margin-top:16rpx;border-radius:16rpx;}.notice {padding:20rpx;background:var(--fill);border-radius:16rpx;font-size:var(--fs-tiny);margin-bottom:20rpx;line-height:1.8;}.history {display:flex;align-items:center;justify-content:space-between;border-bottom:1rpx solid var(--line);padding:16rpx 0;}.history-main {display:flex;gap:16rpx;align-items:center;flex:1;min-width:0;font-size:var(--fs-sub);}.history image {width:90rpx;height:120rpx;flex-shrink:0;}.refresh {padding:24rpx;text-align:center;color:var(--brand);font-size:var(--fs-tiny);}
