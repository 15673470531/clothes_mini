/* 衣橱页：只留本页布局，共用件走 app.wxss */

/* 分类直接作为页首，不再用装饰卡片占用图片墙空间。 */
.cats {
  margin: 0 0 12rpx;
}

.cat {
  padding: 14rpx 24rpx;
  margin-right: 12rpx;
  color: var(--text-sub);
}

.cat.tag-on {
  color: var(--brand);
  font-weight: 600;
}

/* 白底图生成中那行总提示（2026-09 方案 6）：浅紫底 + 主题字，跟普通统计行区分开 */
.normalize-note {
  margin: 0 0 20rpx;
  padding: 18rpx 24rpx;
  border-radius: 18rpx;
  background: var(--brand-light);
  color: var(--brand);
  font-size: var(--fs-sub);
}

.result-count {
  margin: 4rpx 4rpx 16rpx;
  font-size: var(--fs-tiny);
  color: var(--text-weak);
  line-height: 1.5;
  font-variant-numeric: tabular-nums;
}

/* ---- 二级类目条 ----
 * 3~4 个细分 + 「全部」，一行 flex:1 均分（宽度走 app.wxss 的 .row5 / .cell），
 * 不做换行 → 不会出现末行只剩一个的参差
 *
 * 观感跟一级胶囊保持一致：未选中就是纯文字、选中给浅紫底。
 * 因为这条在页面底色上，格子的 --fill(#F4F0EA) 跟底色(#FBF8F4) 几乎同色，
 * 照 .cell 默认渲染的话未选中看不见、选中的却带一圈描边，一行里像两种控件。
 */
.subs {
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.subs .cell {
  height: 56rpx;
  font-size: var(--fs-tiny);
  border-radius: var(--r-pill);
}

.subs .cell:not(.on) {
  background: transparent;
  border-color: transparent;
}

.subs .cell.on {
  border-color: transparent;
}

/* ---- 图片墙 ----
 * 布局走 app.wxss 的共用件（.wall / .wall-cell / .wall-pic / .wall-ph / .wall-text），
 * 本页只补一个「照片存哪了」的小圆点
 */

/* 右下角小圆点：只给颜色，不写字（写字的版本 2026-09 复盘时去掉，照片太小、字压画面）
 * 白圈 + 淡阴影是为了不管压在浅色衣服还是深色衣服上都看得见；
 * 三态互斥、位置尺寸统一，同一张图只会有一个点 */
.pend {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.25);
  background: rgba(0, 0, 0, 0.45);   /* 兜底：未知状态用灰黑 */
}

/* 还没传到云端（本机有图、云端没地址） */
.pend-wait {
  background: rgba(0, 0, 0, 0.45);
}


/* 已上传到服务器本地盘（没配 OSS 时的兜底） */
.pend-local {
  background: var(--warning);
}


/* 新版透明底插画：缩小体量，给说明与添加按钮留出空间。 */
.empty-pic-wd { width: 320rpx; margin-bottom: 20rpx; }

/* 三列卡片的操作入口与名称并排，独立响应点击。 */
.item-caption { display: flex; align-items: center; gap: 4rpx; margin-top: 4rpx; }
.item-caption .wall-text { flex: 1; min-width: 0; margin-top: 0; text-align: left; white-space: normal; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; line-height: 1.5; overflow: hidden; word-break: break-all; }
.item-more {
  width: 64rpx; height: 64rpx; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  border-radius: var(--r-pill); color: var(--text-sub); font-size: var(--fs-strong);
}
.item-more-pressed { background: var(--fill); }

/* 完整展示照片时用白底补齐比例差，避免两侧或上下露灰边。 */
.wall-media image.wall-pic {
  background: #fff;
  border-radius: 16rpx;
}

.login-empty { padding-top: 64rpx; }
.login-title { display: block; margin-bottom: 12rpx; color: var(--text); font-size: var(--fs-strong); font-weight: 600; }

/* 与穿搭页统一空态节奏，空衣橱只提供一个主要操作。 */
.wardrobe-empty { padding: 52rpx 24rpx 72rpx; }
.wardrobe-empty .empty-img, .login-empty .empty-img { margin-bottom: 28rpx; }
.wardrobe-empty-title { display: block; color: var(--text); font-size: var(--fs-strong); font-weight: 600; line-height: 1.5; }
.wardrobe-empty-desc { margin-top: 14rpx; font-size: var(--fs-sub); line-height: 1.8; }
.wardrobe-empty-hint { display: block; margin-top: 8rpx; font-size: var(--fs-tiny); color: var(--text-weak); }
.wardrobe-filter-empty { padding: 96rpx 24rpx; }
.pending-notice { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 20rpx 24rpx; margin-bottom: 20rpx; border-radius: 16rpx; background: var(--fill); color: var(--text-sub); font-size: var(--fs-tiny); }
.pending-link { flex-shrink: 0; color: var(--brand); font-weight: 500; }
.item-caption { min-height: 72rpx; }
